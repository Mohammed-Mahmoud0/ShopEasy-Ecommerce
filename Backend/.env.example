# Copy to .env in the project root and fill in the secrets.
DB_URL=jdbc:postgresql://localhost:5432/shopeasy
DB_USERNAME=postgres
DB_PASSWORD=your-postgres-password
DB_SCHEMA=shopeasy_app
JWT_SECRET=base64-encoded-random-32-byte-key
JWT_ISSUER=http://localhost:8080
ADMIN_EMAIL=admin@shopeasy.local
ADMIN_PASSWORD=at-least-12-random-characters
